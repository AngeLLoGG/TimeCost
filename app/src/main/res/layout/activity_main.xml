<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#F2F2F7"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINANZAS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="#8E8E93" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="TimeCost"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Calcula el valor real de tus compras en tiempo de vida."
            android:textSize="15sp"
            android:textColor="#6C6C70" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="8dp"
            android:text="TUS DATOS LABORALES"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:textColor="#8E8E93" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sueldo neto (S/)"
                        android:textSize="16sp"
                        android:textColor="#000000" />

                    <EditText
                        android:id="@+id/etMonthlySalary"
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:hint="S/ 0.00"
                        android:textColorHint="#C7C7CC"
                        android:textColor="#007AFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.7dp"
                    android:background="#E5E5EA" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Horas al mes"
                        android:textSize="16sp"
                        android:textColor="#000000" />

                    <EditText
                        android:id="@+id/etMonthlyHours"
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:gravity="end|center_vertical"
                        android:hint="160"
                        android:textColorHint="#C7C7CC"
                        android:textColor="#007AFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="8dp"
            android:text="EL GASTO"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:textColor="#8E8E93" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingHorizontal="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Precio del producto (S/)"
                    android:textSize="16sp"
                    android:textColor="#000000" />

                <EditText
                    android:id="@+id/etProductPrice"
                    android:layout_width="140dp"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:gravity="end|center_vertical"
                    android:hint="S/ 0.00"
                    android:textColorHint="#C7C7CC"
                    android:textColor="#007AFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:inputType="numberDecimal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Calcular impacto"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp"
            app:backgroundTint="#007AFF"
            app:elevation="0dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFFFFF"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COSTE EN TIEMPO"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="#8E8E93" />

                <TextView
                    android:id="@+id/tvResultTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:text="2 h y 45 min"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Impacto en tu jornada (8h):"
                        android:textSize="12sp"
                        android:textColor="#8E8E93" />

                    <TextView
                        android:id="@+id/tvProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="34%"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#000000" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBarWorkday"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_bar_custom"
                    android:layout_marginBottom="14dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.7dp"
                    android:background="#E5E5EA"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvHourlyRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu valor hora: S/ 15.50"
                    android:textSize="14sp"
                    android:textColor="#6C6C70" />

                <TextView
                    android:id="@+id/tvAdvice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="#F2F2F7"
                    android:text="Gasto moderado"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#34C759" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>